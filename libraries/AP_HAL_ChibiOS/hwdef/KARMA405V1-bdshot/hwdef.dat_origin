
# hw definition file for processing by chibios_hwdef.py
# for KARMA405V1 hardware.
# thanks to betaflight for pin information


# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID for firmware load
APJ_BOARD_ID 1190

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# bootloader takes first sector
FLASH_RESERVE_START_KB 48

define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1

STM32_ST_USE_TIMER 5

# SPI devices

# SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# SPI2
PB13 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2

# SPI3
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

# Chip select pins
PB12 SDCARD1_CS CS
PC14 OSD1_CS CS
PA4 GYRO1_CS CS

# Beeper
PB11 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80

# SERIAL ports
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 USART6
# PA10 IO-debug-console
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1
PB6 USART1_TX USART1 NODMA
PB7 USART1_RX USART1 NODMA
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_DJI_FPV

# USART2
PA2 USART2_TX USART2
PA3 USART2_RX USART2
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN

# USART3
PC10 USART3_TX USART3 NODMA
PC11 USART3_RX USART3 NODMA
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_None

# UART4
PA1 UART4_RX UART4 NODMA
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_ESCTelemetry
define DEFAULT_SERIAL4_BAUD 19200

# UART5
PC12 UART5_TX UART5
PD2 UART5_RX UART5 NODMA
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL5_BAUD AP_SERIALMANAGER_GPS_BAUD

# USART6
# PC6 USART6_TX USART6 NODMA
# PC7 USART6_RX USART6 NODMA
PC6 USART6_TX USART6 NODMA
PC7 USART6_RX USART6 NODMA
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_None

# I2C ports
I2C_ORDER I2C1
# I2C1
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

# ADC ports

# ADC1
PB1 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 9
define HAL_BATT_CURR_SCALE 75.0
PC0 RSSI_ADC ADC1
define BOARD_RSSI_ANA_PIN 10
PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_VOLT_SCALE 22.1
define HAL_BATT_MONITOR_DEFAULT 4

# MOTORS
PC8 TIM8_CH3 TIM8 PWM(1) GPIO(50)            # M1
PC9 TIM8_CH4 TIM8 PWM(2) GPIO(51) BIDIR      # M2
PA8 TIM1_CH1 TIM1 PWM(3) GPIO(52)            # M3
PA9 TIM1_CH2 TIM1 PWM(4) GPIO(53) BIDIR      # M4

# SERVO
PB15 TIM12_CH2 TIM12 PWM(5) GPIO(54)  NODMA  # S1
PB10 TIM2_CH3 TIM2 PWM(6) GPIO(55)           # S2

# Camera control
PA15 CAM_SWITCH OUTPUT HIGH GPIO(56)
define RELAY1_PIN_DEFAULT 56

# USER IO
PA0 USER_IO3 OUTPUT LOW GPIO(57)
define RELAY3_PIN_DEFAULT 57

# LEDs
PB0 LED0 OUTPUT LOW GPIO(90)
define HAL_GPIO_A_LED_PIN 90

# OSD setup
SPIDEV osd SPI3 DEVID1 OSD1_CS   MODE0  10*MHZ  10*MHZ

define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

# Barometer setup
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_BMP280_ENABLED 1
define AP_BARO_DPS280_ENABLED 1
define AP_BARO_SPL06_ENABLED  1
BARO SPL06  I2C:0:0x76
BARO BMP280 I2C:0:0x76
BARO DPS310 I2C:0:0x76

# IMU setup
SPIDEV icm42688   SPI1 DEVID1 GYRO1_CS   MODE3   1*MHZ   8*MHZ

# SDCard
SPIDEV sdcard SPI2 DEVID1 SDCARD1_CS  MODE0 400*KHZ 25*MHZ

define HAL_LOGGING_ENABLED 1
define HAL_LOGGING_FILESYSTEM_ENABLED 1
# filesystem setup on sdcard
define HAL_OS_FATFS_IO 1
define AP_SDCARD_STORAGE_ENABLED 1
# define HAL_LOGGING_FILE_BUFSIZE 20

IMU Invensensev3 SPI:icm42688 ROTATION_YAW_180
DMA_NOSHARE SPI1* SPI2*
DMA_PRIORITY SPI3_TX I2C1_RX USART2_RX

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
define HAL_DEFAULT_INS_FAST_SAMPLE 3
# Motor order implies Betaflight/X for standard ESCs
define HAL_FRAME_TYPE_DEFAULT 12



# minimal drivers to reduce flash usage
include ../include/minimize_common.inc
include ../include/minimize_fpv_osd.inc
include ../include/no_bootloader_DFU.inc


define DEFAULT_NTF_LED_TYPES 257

# For tunning filters
undef HAL_GYROFFT_ENABLED
define HAL_GYROFFT_ENABLED 1

# Required params for Shpagin's stabilization
undef HAL_BARO_WIND_COMP_ENABLED
undef EK3_FEATURE_EXTERNAL_NAV
undef AP_OPTICALFLOW_ENABLED
undef HAL_VISUALODOM_ENABLED
undef EK3_FEATURE_DRAG_FUSION
undef MODE_GUIDED_NOGPS_ENABLED

define HAL_BARO_WIND_COMP_ENABLED 1
define EK3_FEATURE_EXTERNAL_NAV 1
define AP_OPTICALFLOW_ENABLED 1
define HAL_VISUALODOM_ENABLED 1
define EK3_FEATURE_DRAG_FUSION 1
define MODE_GUIDED_NOGPS_ENABLED 1

# non-used features
undef AP_MOTORS_FRAME_HEXA_ENABLED
define AP_MOTORS_FRAME_HEXA_ENABLED 0
undef AP_MOTORS_FRAME_OCTA_ENABLED
define AP_MOTORS_FRAME_OCTA_ENABLED 0
# undef AP_TRAMP_ENABLED
# define AP_MOTORS_FRAME_OCTA_ENABLED 0

undef AP_NOTIFY_OREOLED_ENABLED
define AP_NOTIFY_OREOLED_ENABLED 0
undef AP_BATTERY_SMBUS_ENABLED
define AP_BATTERY_SMBUS_ENABLED 0
undef HAL_PARACHUTE_ENABLED
define HAL_PARACHUTE_ENABLED 0
undef AP_BATTERY_SYNTHETIC_CURRENT_ENABLED
define AP_BATTERY_SYNTHETIC_CURRENT_ENABLED 0
# undef AP_FRSKY_TELEM_ENABLED
# define AP_FRSKY_TELEM_ENABLED 0


# Disable unwanted baro drivers
define AP_BARO_FBM320_ENABLED 0
define AP_BARO_ICM20789_ENABLED 0
define AP_BARO_ICP101XX_ENABLED 0
define AP_BARO_ICP201XX_ENABLED 0
define AP_BARO_LPS2XH_ENABLED 0
define AP_BARO_MS5611_ENABLED 0
define AP_BARO_BMP085_ENABLED 0
define AP_BARO_BMP388_ENABLED 0
define AP_BARO_BMP581_ENABLED 0


#
define AP_GPS_MAV_ENABLED 1
define HAL_CRSF_TELEM_ENABLED 1
